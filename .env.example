# =========================================================================
# Database (Supabase / Neon / local Postgres)
# =========================================================================
# Pooled connection — used at runtime by the Next.js app.
# Supabase: Project Settings -> Database -> Connection string -> Transaction (port 6543)
# Append ?pgbouncer=true&connection_limit=1 when using the transaction pooler.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"

# Direct connection — used by `prisma migrate deploy` only.
# Supabase: Project Settings -> Database -> Connection string -> Direct connection (port 5432)
DIRECT_URL="postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres"
#
# If `prisma migrate deploy` (or Vercel build) fails with P3005: database schema is not
# empty, you already have app tables in `public` (e.g. from a previous `prisma db push`)
# without migration history. From this repo root, with the SAME DATABASE_URL and DIRECT_URL:
#   npx prisma migrate resolve --applied 20260417000000_init
#   npx prisma migrate deploy
# Or: npm run db:mark-init-applied

# =========================================================================
# Auth.js (NextAuth v5)
# =========================================================================
# Generate: openssl rand -base64 32
AUTH_SECRET=""
# App origin — must match `next dev` port (default 3000) or your production URL
AUTH_URL="http://localhost:3000"
# Legacy (optional): NEXTAUTH_URL / NEXTAUTH_SECRET for old docs or tooling

# Dashboard admin (bcrypt hash of password — see README)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH=""

# =========================================================================
# Gemini — text drafting + topic suggestions + image generation
# =========================================================================
GEMINI_API_KEY=""
GEMINI_TEXT_MODEL="gemini-2.5-flash"
GEMINI_IMAGE_MODEL="gemini-2.0-flash-preview-image-generation"

# =========================================================================
# News search (recommended for production)
# — Google Custom Search JSON API: real result URLs, fewer "hallucinated" links.
# Create a Programmable Search Engine: https://programmablesearchengine.google.com
# (enable "Search the entire web")
# API key + enable "Custom Search API": https://console.cloud.google.com/apis/credentials
# Free tier: 100 queries/day; overage ~$5 per 1,000.
# Leave both empty to use Gemini Google Search grounding + verified URLs (fallback: fewer setup steps)
# =========================================================================
GOOGLE_CSE_API_KEY=""
GOOGLE_CSE_ID=""

# =========================================================================
# Token encryption — 32 bytes hex (64 chars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =========================================================================
ENCRYPTION_KEY=""

# =========================================================================
# Cloudflare R2 (public images for IG/FB)
# Without R2 the app returns base64 data URLs (dev only — do NOT use in prod).
# Either the new R2_ENDPOINT style OR the older R2_ACCOUNT_ID style is accepted.
# =========================================================================
R2_ENDPOINT=""                 # e.g. https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_BUCKET_NAME=""       # public bucket name
R2_PUBLIC_URL=""               # e.g. https://pub-xxxx.r2.dev  OR  your custom domain

# Optional aliases (legacy):
# R2_ACCOUNT_ID=""
# R2_BUCKET=""
# R2_PUBLIC_BASE_URL=""

# =========================================================================
# Image generation references (static folder public/reference-images/)
# =========================================================================
# A global default reference category is NOT read by the app (it made every image
# look the same). Pass per-request referenceCategory from queue UI regenerate /
# generate-variations, or a future campaign field, to lock a look when you want it.
# REFERENCE_DEFAULT_CATEGORY="logistics-hero"

# =========================================================================
# Meta (Facebook Page + Instagram)
# Use Graph API Explorer / System User for long-lived Page token.
# =========================================================================
META_APP_ID=""
META_APP_SECRET=""

# =========================================================================
# LinkedIn OAuth (optional if using manual tokens only)
# =========================================================================
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:3000/api/oauth/linkedin/callback"

# =========================================================================
# OMG site newsroom API
# =========================================================================
OMG_API_BASE="https://cargo.omgexp.com"
OMG_AGENT_TOKEN=""

# =========================================================================
# Cron — random string; required when calling /api/cron/* from outside Vercel
# Vercel Cron invocations bypass this check via x-vercel-cron header.
# =========================================================================
CRON_SECRET=""

# =========================================================================
# Agent daily budget (posts created per cron run across all active topics)
# =========================================================================
CONTENT_BUDGET_PER_DAY="3"
