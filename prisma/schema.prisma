// Social Media Agent — data model

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PostStatus {
  DRAFTING
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHED
  FAILED
  REJECTED
}

enum Platform {
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  OMG
}

enum CredentialType {
  META
  LINKEDIN
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum CampaignCadence {
  DAILY
  WEEKLY
  WEEKLY_MULTI
  BIWEEKLY
  MONTHLY
  SPECIFIC_DATES
  CUSTOM
  /// Minute-level wall times in scheduleConfig.datetimes (YYYY-MM-DDTHH:mm in campaign TZ).
  CUSTOM_DATETIMES
}

enum CampaignTheme {
  RELIABILITY_PRO
  INNOVATION_TECH
  SPEED_URGENCY
}

/// NEWS_DRIVEN: each run fetches real news from keywords. SELF_PROMO: brand-only, no required news.
enum CampaignContentMode {
  NEWS_DRIVEN
  SELF_PROMO
}

model Topic {
  id                String   @id @default(cuid())
  name              String
  keywords          String
  brandVoice        String?  @db.Text
  /// Code registry id in lib/brands (e.g. omg, acme)
  brandTemplateId   String   @default("omg")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  posts             Post[]

  @@index([createdAt(sort: Desc)])
  @@index([brandTemplateId])
}

model NewsItem {
  id        String   @id @default(cuid())
  url       String   @unique
  urlHash   String   @unique
  title     String
  snippet   String?  @db.Text
  fetchedAt DateTime @default(now())
  posts     Post[]
}

model Post {
  id           String     @id @default(cuid())
  status       PostStatus @default(DRAFTING)
  topicId      String?
  topic        Topic?     @relation(fields: [topicId], references: [id])
  campaignId   String?
  campaign     Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  sourceNewsId  String?
  sourceNews    NewsItem?  @relation(fields: [sourceNewsId], references: [id])
  /// Content pillar assigned to this post (rotated per-post within a campaign run)
  contentPillar String?
  scheduledAt   DateTime?
  publishedAt  DateTime?
  failureCount Int        @default(0)
  lastError    String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  variants     PostVariant[]
  publishLogs  PublishLog[]
  postPlan     PostPlan?

  @@index([status, createdAt(sort: Desc)])
  @@index([status, scheduledAt])
  @@index([campaignId, createdAt(sort: Desc)])
  @@index([campaignId, status])
  @@index([topicId])
  @@index([sourceNewsId])
}

model Campaign {
  id            String            @id @default(cuid())
  name          String
  description   String?           @db.Text
  /// Code registry id in lib/brands (e.g. omg, acme)
  brandTemplateId String          @default("omg")
  status        CampaignStatus    @default(DRAFT)
  keywords      String
  brandVoice    String?           @db.Text
  theme         CampaignTheme
  contentMode   CampaignContentMode @default(NEWS_DRIVEN)
  /// BCP-47 language code for generated content, e.g. "en", "th"
  contentLanguage String            @default("en")
  /// e.g. "Brand Awareness", "Lead Generation", "Engagement"
  campaignGoal        String?       @db.Text
  /// Target audience description, pain points, goals
  targetPersona       String?       @db.Text
  /// Comma-separated content pillars, e.g. "Educational, Promotional, Behind the scenes"
  contentPillars      String?       @db.Text
  cadence       CampaignCadence
  dayOfWeek     Int?
  hourOfDay     Int?
  /// Desired wall-clock hour (0-23) for the post to actually go live.
  /// When null + autoApprove, posts publish ~2 min after the agent run.
  publishHourOfDay Int?
  /// Minute within that hour (0-59). Null means 0 when publishHourOfDay is set (legacy rows).
  publishMinuteOfHour Int?
  /// Minutes between each post's scheduled publish time after the first slot (campaign TZ). Agent defaults to 5 when null.
  publishSpacingMinutes Int?
  /// Optional explicit wall-clock times HH:mm (campaign TZ), in order; cycles if fewer than postsPerRun. Overrides spacing when non-empty.
  publishTimes          Json?
  timezone      String            @default("Asia/Bangkok")
  customCron    String?
  scheduleConfig Json?
  platforms     Platform[]
  postsPerRun   Int               @default(1)
  imagesPerPost Int               @default(1)
  totalPostsCap Int?
  autoApprove   Boolean           @default(false)
  startAt       DateTime          @default(now())
  endAt         DateTime?
  nextRunAt     DateTime?
  lastRunAt     DateTime?
  /// Per-platform copy guidance: { FACEBOOK?: string, INSTAGRAM?: string, LINKEDIN?: string, OMG?: string }
  platformStrategies   Json?
  /// Up to 4 R2 image URLs generated for visual direction reference
  moodboardImages      Json?
  moodboardGeneratedAt DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  posts         Post[]
  runs          CampaignRun[]
  plans         PostPlan[]

  @@index([status, nextRunAt])
  @@index([updatedAt(sort: Desc)])
  @@index([brandTemplateId])
}

model CampaignRun {
  id         String     @id @default(cuid())
  campaignId String
  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  ok         Boolean    @default(false)
  postId     String?
  error      String?    @db.Text

  @@index([campaignId, startedAt(sort: Desc)])
  @@index([startedAt(sort: Desc)])
}

model PostVariant {
  id          String    @id @default(cuid())
  postId      String
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  platform    Platform
  caption     String    @db.Text
  hashtags    String?   @db.Text
  bodyMd      String?   @db.Text
  title       String?
  slug        String?
  meta        Json?
  remoteId    String?
  publishedAt DateTime?
  media       Media[]

  @@unique([postId, platform])
}

model Media {
  id          String      @id @default(cuid())
  variantId   String
  variant     PostVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  imageUrl    String
  prompt      String?     @db.Text
  generatedBy String      @default("gemini")
  createdAt   DateTime    @default(now())

  @@index([variantId])
}

/// Editable in Settings; `slug` matches Campaign.brandTemplateId and Topic.brandTemplateId
model BrandTemplateMaster {
  id          String   @id @default(cuid())
  slug        String   @unique
  displayName String
  payload     Json
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}

model PlatformCredential {
  id               String         @id @default(cuid())
  type             CredentialType @unique
  encryptedPayload String         @db.Text
  expiresAt        DateTime?
  updatedAt        DateTime       @updatedAt
}

model Persona {
  id           String   @id @default(cuid())
  name         String
  /// Job title / role — e.g. "CFO at mid-size logistics company"
  role         String?  @db.Text
  /// Age range, region, company size, etc.
  demographics String?  @db.Text
  /// Core pain points — what keeps them up at night
  painPoints   String?  @db.Text
  /// What they want to achieve
  goals        String?  @db.Text
  /// Full persona description injected into AI prompts — can be auto-composed or manually written
  description  String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt(sort: Desc)])
}

enum PlanStatus {
  PENDING
  EXECUTED
  SKIPPED
}

model PostPlan {
  id           String     @id @default(cuid())
  campaignId   String
  campaign     Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /// The wall-clock datetime this slot is planned to execute (matches agent run time)
  scheduledFor DateTime
  /// 0-based index of this post within the run (for postsPerRun > 1)
  indexInRun   Int        @default(0)
  pillar       String?    @db.Text
  brief        String?    @db.Text
  keywordHint  String?    @db.Text
  status       PlanStatus @default(PENDING)
  /// Set after agent generates a post from this plan
  postId       String?    @unique
  post         Post?      @relation(fields: [postId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([campaignId, scheduledFor, indexInRun])
  @@index([campaignId, scheduledFor])
  @@index([scheduledFor, status])
}

model PublishLog {
  id           String   @id @default(cuid())
  postId       String
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  platform     Platform
  attemptAt    DateTime @default(now())
  success      Boolean
  remoteId     String?
  errorMessage String?  @db.Text

  @@index([postId, attemptAt(sort: Desc)])
}
