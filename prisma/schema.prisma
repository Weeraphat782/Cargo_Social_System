// Social Media Agent — data model

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PostStatus {
  DRAFTING
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHED
  FAILED
  REJECTED
}

enum Platform {
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  OMG
}

enum CredentialType {
  META
  LINKEDIN
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum CampaignCadence {
  DAILY
  WEEKLY
  WEEKLY_MULTI
  BIWEEKLY
  MONTHLY
  SPECIFIC_DATES
  CUSTOM
  /// Dev-only: minute-level datetimes in scheduleConfig.datetimes; blocked in production API.
  TEST_MINUTES
}

enum CampaignTheme {
  RELIABILITY_PRO
  INNOVATION_TECH
  SPEED_URGENCY
}

/// NEWS_DRIVEN: each run fetches real news from keywords. SELF_PROMO: brand-only, no required news.
enum CampaignContentMode {
  NEWS_DRIVEN
  SELF_PROMO
}

model Topic {
  id         String   @id @default(cuid())
  name       String
  keywords   String
  brandVoice String?  @db.Text
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  posts      Post[]
}

model NewsItem {
  id        String   @id @default(cuid())
  url       String   @unique
  urlHash   String   @unique
  title     String
  snippet   String?  @db.Text
  fetchedAt DateTime @default(now())
  posts     Post[]
}

model Post {
  id           String     @id @default(cuid())
  status       PostStatus @default(DRAFTING)
  topicId      String?
  topic        Topic?     @relation(fields: [topicId], references: [id])
  campaignId   String?
  campaign     Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  sourceNewsId String?
  sourceNews   NewsItem?  @relation(fields: [sourceNewsId], references: [id])
  scheduledAt  DateTime?
  publishedAt  DateTime?
  failureCount Int        @default(0)
  lastError    String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  variants     PostVariant[]
  publishLogs  PublishLog[]

  @@index([status, createdAt(sort: Desc)])
  @@index([status, scheduledAt])
  @@index([campaignId, createdAt(sort: Desc)])
  @@index([topicId])
  @@index([sourceNewsId])
}

model Campaign {
  id            String            @id @default(cuid())
  name          String
  description   String?           @db.Text
  status        CampaignStatus    @default(DRAFT)
  keywords      String
  brandVoice    String?           @db.Text
  theme         CampaignTheme
  contentMode   CampaignContentMode @default(NEWS_DRIVEN)
  cadence       CampaignCadence
  dayOfWeek     Int?
  hourOfDay     Int?
  timezone      String            @default("Asia/Bangkok")
  customCron    String?
  scheduleConfig Json?
  platforms     Platform[]
  postsPerRun   Int               @default(1)
  totalPostsCap Int?
  autoApprove   Boolean           @default(false)
  startAt       DateTime          @default(now())
  endAt         DateTime?
  nextRunAt     DateTime?
  lastRunAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  posts         Post[]
  runs          CampaignRun[]

  @@index([status, nextRunAt])
  @@index([updatedAt(sort: Desc)])
}

model CampaignRun {
  id         String     @id @default(cuid())
  campaignId String
  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  ok         Boolean    @default(false)
  postId     String?
  error      String?    @db.Text

  @@index([campaignId, startedAt(sort: Desc)])
}

model PostVariant {
  id          String    @id @default(cuid())
  postId      String
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  platform    Platform
  caption     String    @db.Text
  hashtags    String?   @db.Text
  bodyMd      String?   @db.Text
  title       String?
  slug        String?
  meta        Json?
  remoteId    String?
  publishedAt DateTime?
  media       Media[]

  @@unique([postId, platform])
}

model Media {
  id          String      @id @default(cuid())
  variantId   String
  variant     PostVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  imageUrl    String
  prompt      String?     @db.Text
  generatedBy String      @default("gemini")
  createdAt   DateTime    @default(now())

  @@index([variantId])
}

model PlatformCredential {
  id               String         @id @default(cuid())
  type             CredentialType @unique
  encryptedPayload String         @db.Text
  expiresAt        DateTime?
  updatedAt        DateTime       @updatedAt
}

model PublishLog {
  id           String   @id @default(cuid())
  postId       String
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  platform     Platform
  attemptAt    DateTime @default(now())
  success      Boolean
  remoteId     String?
  errorMessage String?  @db.Text

  @@index([postId, attemptAt(sort: Desc)])
}
